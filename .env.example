# TeamDocs — ejemplo SIN credenciales reales. Copiar a .env y rellenar en local.
# Nunca commitear .env con valores reales (Hard Rule: no secrets en git).

# Neon Postgres (proyecto kawai-anime, region aws-us-east-2, PG17, branch main)
# Copiar desde Neon Console -> Connection Details -> pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXXXX-c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXXXX.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generar-con-openssl-rand-base64-48"
BETTER_AUTH_URL="http://localhost:3000"

# Hocuspocus (servidor colaborativo local)
COLLAB_PORT="1234"
COLLAB_URL="ws://localhost:1234"
# Token interno para que web y collab se autentiquen entre si (no es de usuario)
COLLAB_INTERNAL_TOKEN="generar-con-openssl-rand-hex-32"

# Web
NEXT_PUBLIC_COLLAB_URL="ws://localhost:1234"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
